# REQUIRED: Your Groq API key (get one FREE at https://console.groq.com/keys - no credit card needed)
GROQ_API_KEY=gsk_your-key-here

# OPTIONAL: Which Groq model to use. Default is llama-3.3-70b-versatile.
# Faster option: llama-3.1-8b-instant
# GROQ_MODEL=llama-3.3-70b-versatile

# OPTIONAL: Set to "false" to run without a database (debates kept in memory only).
# Leave as default (true) for local dev so History persists in a SQLite file.
# On free cloud hosting like Render, set this to false.
# USE_DATABASE=true

# OPTIONAL: Only used when USE_DATABASE=true. Leave blank for local SQLite file.
# DATABASE_URL=postgresql://user:password@host:5432/cognitivemesh
